{
    "name": "@dalbit-yaksok/editor",
    "version": "7.0.0-RC.3",
    "exports": "./src/index.ts",
    "imports": {
        "solid-js": "npm:solid-js@^2.0.0-rc.1",
        "@solidjs/web": "npm:@solidjs/web@^2.0.0-rc.1"
    },
    "compilerOptions": {
        "strict": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "@solidjs/web",
        "isolatedModules": true
    },
    "tasks": {
        "dev": "deno run -A npm:vite@^8.2.2 serve --config dev/vite.config.ts",
        "build": "deno run -A npm:vite@^8.2.2 build --config dev/vite.config.ts",
        "build:app": "deno run -A npm:vite@^8.2.2 build --config dev/vite.config.ts --mode app",
        "preview": "deno run -A npm:vite@^8.2.2 preview --config dev/vite.config.ts --mode app",
        "check": "deno check src/ dev/"
    }
}
