{
    "description": "Shared repository guardrails used by Claude Code, Codex, and Pi",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/no-shell-file-edit.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Bash|Grep|Find",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/ast-grep-only.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/no-output-filtering.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/save-long-output.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/one-command-at-a-time.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/oxlint-after-edit.sh\"",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
