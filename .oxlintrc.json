{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "typescript/no-explicit-any": "off"
    },
    "env": {
        "builtin": true,
        "deno": true
    },
    "ignorePatterns": ["docs/.vitepress/dist", "docs/api", "node_modules"]
}
