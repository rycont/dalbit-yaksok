{
    "compilerOptions": {
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "target": "esnext",
        "lib": ["ESNext", "DOM"],
        "allowSyntheticDefaultImports": true,
        "strictNullChecks": true
    },
    "include": ["./**/*.ts"]
}
